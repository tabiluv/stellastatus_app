{
  "name": "stellastatus-app",
  "productName": "StellaStatus",
  "version": "1.0.7",
  "fullVersion": "1.0.7",
  "description": "스텔라이브 멤버의 치지직 방송 상태를 확인하고 윈도우 알림을 보내주는 데스크톱 앱",
  "author": {
    "name": "StellaStatus",
    "email": "tabi.luv@icloud.com"
  },
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "gen-icon": "node scripts/gen-icon.mjs",
    "gen-logos": "node scripts/normalize-logos.mjs",
    "gen-art": "node scripts/gen-installer-art.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist-mac": "node scripts/build-mac.mjs",
    "build-setup": "node scripts/build-setup.mjs",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "stellastatus": "^0.1.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabiluv/stellastatus_app.git"
  }
}
